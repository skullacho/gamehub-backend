# Porta do servidor local
PORT=5000

# String de conexão com o MongoDB Atlas
# Substitua com suas credenciais:
# mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/gamehub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://seu_usuario:sua_senha@seu_cluster.mongodb.net/gamehub?retryWrites=true&w=majority

# Ambiente de execução
NODE_ENV=development

# Origens permitidas no CORS (separadas por vírgula)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
